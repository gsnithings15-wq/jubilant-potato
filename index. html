<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEO AI</title>
<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #101827;
  color: white;
}
header {
  padding: 22px;
  text-align: center;
  background: #17243b;
  font-size: 25px;
  font-weight: bold;
}
main {
  padding: 20px;
  max-width: 600px;
  margin: auto;
}
#chat {
  height: 65vh;
  overflow-y: auto;
  padding: 12px;
}
.message {
  padding: 13px;
  margin: 10px 0;
  border-radius: 12px;
  background: #243550;
}
.user { background: #176b87; }
.input-area {
  display: flex;
  gap: 8px;
  position: fixed;
  bottom: 15px;
  left: 10px;
  right: 10px;
}
input {
  flex: 1;
  padding: 15px;
  border-radius: 12px;
  border: none;
}
button {
  background: #00bcd4;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
}
</style>
</head>
<body>
<header>✦ NEO AI</header>
<main>
<div id="chat">
<div class="message">Hello! Welcome to NEO AI. How can I help you?</div>
</div>
<div class="input-area">
<input id="question" placeholder="Ask NEO AI anything...">
<button onclick="send()">Send</button>
</div>
</main>
<script>
function send() {
 const input = document.getElementById("question");
 const chat = document.getElementById("chat");
 const message = input.value.trim();
 if (!message) return;
 chat.innerHTML += '<div class="message user"></div>';
 chat.lastElementChild.textContent = message;
 input.value = "";
 chat.scrollTop = chat.scrollHeight;
}
</script>
</body>
